{
  "env": {
    "ANDROID_HOME": "/home/emanuele/Android/Sdk",
    "ANDROID_SDK_ROOT": "/home/emanuele/Android/Sdk"
  },
  "permissions": {
    "allow": [
      "Bash(adb:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(dart:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(flutter:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(git config --get:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git init:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(git worktree:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(pkg-config:*)",
      "Bash(pwd:*)",
      "Bash(rm:*)",
      "Bash(scripts/obiettivo.sh:*)",
      "Bash(scripts/sorveglia.sh:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(timeout:*)",
      "Bash(touch:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Edit",
      "MultiEdit",
      "Write"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Read(**/.env)",
      "Read(**/key.properties)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/obiettivo-stop.sh"
          }
        ]
      }
    ]
  }
}
